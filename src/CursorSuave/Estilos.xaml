<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Estilos compartilhados (mesclados em App.xaml). Os pincéis DynamicResource vêm do tema Fluent de cada janela. -->
    <!-- Interruptor: a linha inteira é o ToggleButton; a pílula fica à direita. -->
    <Style x:Key="LinhaInterruptor" TargetType="ToggleButton">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Fundo" Background="Transparent" CornerRadius="6" Margin="4,1" Padding="12,0">
                        <Grid>
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Border x:Name="Pilula" Width="40" Height="20" CornerRadius="10" HorizontalAlignment="Right"
                                    BorderThickness="1" Background="Transparent"
                                    BorderBrush="{DynamicResource TextFillColorSecondaryBrush}">
                                <Ellipse x:Name="Bolinha" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0"
                                         Fill="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="#22808080"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pilula" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            <Setter TargetName="Pilula" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            <Setter TargetName="Bolinha" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Bolinha" Property="Margin" Value="0,0,4,0"/>
                            <Setter TargetName="Bolinha" Property="Fill" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
