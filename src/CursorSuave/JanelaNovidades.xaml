<Window x:Class="CursorSuave.JanelaNovidades"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ThemeMode="System"
        Title="Cursor Suave - Novidades" Width="420" SizeToContent="Height" MaxHeight="640"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TxtTitulo" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,14"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Lista"/>
        </ScrollViewer>
        <Button x:Name="BtnEntendi" Grid.Row="2" Content="Entendi" HorizontalAlignment="Right" MinWidth="110" Padding="0,6"
                Margin="0,16,0,0" IsDefault="True" IsCancel="True" Style="{DynamicResource AccentButtonStyle}"/>
    </Grid>
</Window>
